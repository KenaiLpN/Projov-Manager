NODE_ENV=development
API_PORT=3333
DATABASE_URL=mysql://usuario:senha@host:3306/banco
DATABASE_CONNECTION_LIMIT=5
JWT_SECRET=substitua-por-um-segredo-forte-e-aleatorio
COOKIE_SECRET=substitua-por-outro-segredo-forte-e-aleatorio
LOGIN_PROXY_SECRET=use-o-mesmo-valor-configurado-no-frontend
# Development/standalone listener; embedded production opens no API port.
API_HOST=127.0.0.1
# Empty by default. Set only verified reverse-proxy IPs/CIDRs, never all addresses.
TRUSTED_PROXY_CIDRS=
FRONTEND_URL=http://localhost:3000
BLOCKED_IPS=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@seu-dominio.com
SMTP_PASS=substitua-pela-senha-da-caixa-de-email
SMTP_FROM_NAME=ProSis
