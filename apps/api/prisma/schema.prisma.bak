generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Aprendiz {
  IdAluno                Int       @id
  CodigoExterno          String?   @db.VarChar(50)
  NomeJovem              String    @db.VarChar(150)
  NomeSocial             String?   @db.VarChar(150)
  IdUnidade              Int?
  IdInstituicaoParceira  Int?
  IdEscola               Int?
  IdMonitorResponsavel   Int?
  IdTurmaCapacitacao     Int?
  DataNascimento         DateTime? @db.Date
  Sexo                   String?   @db.VarChar(20)
  EstadoCivil            String?   @db.VarChar(20)
  Nacionalidade          String?   @db.VarChar(50)
  UF_Naturalidade        String?   @db.Char(2)
  Naturalidade           String?   @db.VarChar(100)
  AlistamentoMilitar     String?   @db.Char(3)
  EstudaAtualmente       String?   @db.Char(3)
  EscolaridadeNivel      String?   @db.VarChar(100)
  TipoAprendizagem       String?   @db.VarChar(50)
  TurnoEscolar           String?   @db.VarChar(20)
  StatusJovem            String?   @db.VarChar(50)
  TipoPagamento          String?   @db.VarChar(30)
  CBO                    String?   @db.VarChar(20)
  AreaAtuacao            String?   @db.VarChar(100)
  HorasDiarias           Int?
  MesesContrato          Int?
  DataInicioEmpresa      DateTime? @db.Date
  DataInicioAprendizagem DateTime? @db.Date
  DataPrevistaTermino    DateTime? @db.Date
  DataDesligamento       DateTime? @db.Date
  DataInicioFerias       DateTime? @db.Date
  DataTerminoFerias      DateTime? @db.Date
  TurmaSimultaneidade    String?   @db.VarChar(100)
  TurmaCCI               String?   @db.VarChar(100)
  RG                     String?   @db.VarChar(20)
  RG_DataEmissao         DateTime? @db.Date
  RG_OrgaoExpedidor      String?   @db.VarChar(20)
  RG_UF                  String?   @db.Char(2)
  CPF                    String?   @unique @db.Char(11)
  PIS                    String?   @db.VarChar(20)
  CTPS_Numero            String?   @db.VarChar(20)
  CTPS_Serie             String?   @db.VarChar(10)
  Reservista             String?   @db.VarChar(20)
  TituloEleitor          String?   @db.VarChar(20)
  TituloSecao            String?   @db.VarChar(10)
  TituloZona             String?   @db.VarChar(10)
  CEP                    String?   @db.Char(8)
  Logradouro             String?   @db.VarChar(150)
  Numero                 String?   @db.VarChar(20)
  Complemento            String?   @db.VarChar(50)
  Bairro                 String?   @db.VarChar(100)
  Municipio              String?   @db.VarChar(100)
  UF_Endereco            String?   @db.Char(2)
  TelefoneFixo           String?   @db.VarChar(20)
  Celular                String?   @db.VarChar(20)
  Email                  String?   @db.VarChar(100)
  OutrosTelefones        String?   @db.VarChar(255)
  UltimaTentativa        String?   @db.VarChar(50)
  DataUltimaInteracao    DateTime? @default(now()) @db.DateTime
  UsaMedicamentos        Boolean?
  MedicamentosQual       String?   @db.VarChar(255)
  MedicamentosFinalidade String?   @db.VarChar(255)
  TemAlergia             Boolean?
  AlergiaQual            String?   @db.VarChar(255)
  TemProblemaSaude       Boolean?
  ProblemaSaudeQual      String?   @db.VarChar(255)
  Deficiencia            String?   @db.VarChar(50)

  @@map("Aprendiz")
}

model CadastroRamoAtividade {
  IdRamo       Int       @id
  Descricao    String    @db.VarChar(150)
  CodigoCNAE   String?   @db.VarChar(20)
  Observacao   String?   @db.Text
  Ativo        Boolean?  @default(true)
  DataInclusao DateTime? @default(now()) @db.DateTime

  @@map("CadastroRamoAtividade")
}

model CadastroRegiao {
  IdRegiao            Int       @id @default(autoincrement())
  NomeRegiao          String    @db.VarChar(100)
  SiglaRegiao         String?   @db.VarChar(10)
  ResponsavelRegional String?   @db.VarChar(100)
  Ativo               Boolean?  @default(true)
  DataCriacao         DateTime? @default(now()) @db.DateTime

  @@map("CadastroRegiao")
}

model Orientadores {
  IdOrientador   Int       @id @default(autoincrement())
  NomeOrientador String    @db.VarChar(150)
  CPF            String?   @unique @db.Char(11)
  Email          String?   @db.VarChar(100)
  Telefone       String?   @db.VarChar(20)
  UnidadeAtuacao String?   @db.VarChar(100)
  Situacao       String?   @default("Ativo") @db.VarChar(20)
  DataCadastro   DateTime? @default(now()) @db.DateTime

  @@index([NomeOrientador])
  @@map("Orientadores")
}

model PerfisAcesso {
  IdPerfil   Int    @id @default(autoincrement())
  NomePerfil String @db.VarChar(50)

  @@map("PerfisAcesso")
}

model MigrationHistory {
  MigrationId    String @db.VarChar(150)
  ContextKey     String @db.VarChar(300)
  Model          Bytes
  ProductVersion String @db.VarChar(32)

  @@id([MigrationId, ContextKey])
  @@map("__MigrationHistory")
}

model CA_AcessosUsuario {
  AceCodigo     String   @db.VarChar(8)
  AceDataHora   DateTime @db.DateTime
  AceTipoAcesso String   @db.VarChar(1)

  @@id([AceCodigo, AceDataHora])
}

model CA_AcessosUsuarios {
  Acesequencia   Int       @id @default(autoincrement())
  AceUsuario     String?   @db.VarChar(8)
  AceDataEntrada DateTime? @db.DateTime
  AceUsuTela     String?   @db.VarChar(50)
}

model CA_AcompanhamentoInscricao {
  AciAprendiz        Int
  AciDataMensagem    DateTime @db.DateTime
  AciTextoMensagem   String?  @db.VarChar(1000)
  AciUsuarioMensagem String?  @db.VarChar(8)

  @@id([AciAprendiz, AciDataMensagem])
}

model CA_AlocacaoAprendiz {
  ALAAprendiz             Int
  ALATurma                Int
  ALAUnidadeParceiro      Int
  ALAStatus               String?   @db.VarChar(1)
  ALATutor                String?   @db.VarChar(8)
  ALADataInicio           DateTime? @db.DateTime
  ALADataPrevTermino      DateTime? @db.DateTime
  ALADataTermino          DateTime? @db.DateTime
  ALAInicioExpediente     DateTime? @db.DateTime
  ALATerminoExpediente    DateTime? @db.DateTime
  ALAValorBolsa           Float?    @db.Float
  ALAValorTaxa            Float?    @db.Float
  ALAObservacao           String?   @db.VarChar(255)
  ALAOrdem Int @id @default(autoincrement())
  ALApagto                String?   @db.VarChar(1)
  ALAOrientador           Int?
  ALAMotivoDesligamento   Int?
  ALAUsuarioCadastro      String?   @db.VarChar(8)
  ALAUsuarioDataCadastro  DateTime? @db.DateTime
  ALAUsuarioAlteracao     String?   @db.VarChar(8)
  ALAUsuarioDataAlteracao DateTime? @db.DateTime
  ALAValorEncargos        Float?    @db.Float
  ALATurmaAnterior        Int?
  ALADataMudaTurma        DateTime? @db.DateTime
  ALAUsuarioMudaTurma     String?   @db.VarChar(8)
  ALAMotivoMudaTurma      String?   @db.VarChar(50)

  @@unique([ALAAprendiz, ALATurma, ALAUnidadeParceiro])
}

model CA_ApuracaoAnualAprendizes {
  ApaAnoRef   String @db.VarChar(4)
  ApaMesRef   String @db.VarChar(2)
  ApaAtivos   Int?
  ApaEntradas Int?
  ApaSaidas   Int?

  @@id([ApaAnoRef, ApaMesRef])
}

model CA_AreaAtuacao {
  AreaCodigo          Int     @id @default(autoincrement())
  AreaDescricao       String? @db.VarChar(80)
  AreaNumeroCadastro  Int?
  AreaCargaHoraria    Int?
  AreaCargaTeorica4h  Int?
  AreaCargaTeorica6h  Int?
  AreaCargaPratica4h  Int?
  AreaCargaPratica6h  Int?
  AreaCertificado     String? @db.VarChar(8000)
  AreaNomeCertificado String? @db.VarChar(150)
}

model CA_AulasCapacitacaoAprendiz {
  AcpAprendiz            Int
  AcpTurma               Int
  AcpDataAula            DateTime  @db.DateTime
  AcpPresenca            String?   @db.VarChar(1)
  AcpUsuario             String?   @db.VarChar(8)
  AcpDataAlteracao       DateTime? @db.DateTime
  AcpPresencaInformatica String?   @db.VarChar(1)

  @@id([AcpAprendiz, AcpTurma, AcpDataAula])
}

model CA_AulasDisciplinasAprendiz {
  AdiCodAprendiz   Int
  AdiTurma         Int
  AdiDisciplina    Int
  AdiEducador      Int
  AdiDataAula      DateTime  @db.DateTime
  AdiCargaHoraria  Int       @db.SmallInt
  AdiPresenca      String?   @db.VarChar(1)
  AdiObservacoes   String?   @db.VarChar(255)
  AdiPresencaTarde String?   @db.VarChar(1)
  AdiUsuario       String?   @db.VarChar(8)
  AdiDataAlteracao DateTime? @db.DateTime

  @@id([AdiCodAprendiz, AdiTurma, AdiDisciplina, AdiEducador, AdiDataAula])
}

model CA_AulasDisciplinasTurmaProf {
  ADPTurma             Int
  ADPprofessor         Int
  ADPDisciplina        Int
  ADPDataAula          DateTime  @db.DateTime
  ADPOrdemAula         Int
  ADPStatus            String?   @db.VarChar(1)
  ADPConteudoLecionado String?   @db.VarChar(1000)
  ADPRecursosUsados    String?   @db.VarChar(1000)
  ADPObservacoes       String?   @db.VarChar(1000)
  ADPUsuario           String?   @db.VarChar(8)
  ADPDataAlteracao     DateTime? @db.DateTime

  @@id([ADPTurma, ADPprofessor, ADPDisciplina, ADPDataAula, ADPOrdemAula])
}

model CA_AutorizacaoUsuario {
  AutFUsuario String @db.VarChar(8)
  AutFFuncao  String @db.VarChar(50)
  AutFTipoAut String @db.VarChar(1)

  @@id([AutFUsuario, AutFFuncao])
}

model CA_AvaliacaoAprendizCapacitacao {
  NcaAprendiz              Int
  NcaTurma                 Int
  NcaNotaGeral             Int?      @db.SmallInt
  NcaPortugues             Int?      @db.SmallInt
  NcaMatematica            Int?      @db.SmallInt
  NcaTecnicasAdm           Int?      @db.SmallInt
  NcaDigitacao             Int?      @db.SmallInt
  NcaRelacoesHumanas       Int?      @db.SmallInt
  NcaCiencias              Int?      @db.SmallInt
  NcaPluralidade           Int?      @db.SmallInt
  NcaInformatica           Int?      @db.SmallInt
  NcaCaracteristicasGerais String?   @db.VarChar(1000)
  NcaWord                  Int?      @db.SmallInt
  NcaExcel                 Int?      @db.SmallInt
  NcaInternet              Int?      @db.SmallInt
  NcaDataAvaliacao         DateTime? @db.DateTime
  NcaUsuarioAvaliacao      String?   @db.VarChar(8)

  @@id([NcaAprendiz, NcaTurma])
}

model CA_Bairros {
  DescBairro String @id @db.VarChar(40)
  RegBairro  Int
}

model CA_CalendarioJovem {
  CLJCodigo               Int
  CLJDataEncontro         DateTime @db.DateTime
  CLJIndice Int @id @default(autoincrement())
  CLJTurma                Int?
  CLJTipo                 Int?
  CLJUnidade              Int?
  CLJUnidadeSemanal       Int?
  CLJUnidadePratica       Int?
  CLJDiaEncontroMensal    Int?
  CLJSemanaEncontroMensal Int?
  CLJUniEmpresa           Int?

  @@unique([CLJCodigo, CLJDataEncontro])
}

model CA_CapacitacaoAprendiz {
  CapSequencia Int @id @default(autoincrement())
  CapAprendiz        Int
  CapTurma           Int
  CapStatus          String    @db.VarChar(1)
  CapUnidade         Int
  CapDataInicio      DateTime  @db.DateTime
  CapDataPrevTermino DateTime? @db.DateTime
  CapDataTermino     DateTime? @db.DateTime
  CapObservacoes     String?   @db.VarChar(1000)

  @@unique([CapAprendiz, CapTurma])
}

model CA_CodigosCEP {
  Cep_Codigo     String  @id @db.VarChar(8)
  Cep_Logradouro String? @db.VarChar(80)
  Cep_Cidade     String? @db.VarChar(50)
  Cep_Bairro     String? @db.VarChar(50)
  Cep_UF         String? @db.VarChar(2)
}

model CA_Conceitos {
  ConCodigo     String  @id @db.VarChar(10)
  ConNota       Float?  @db.Float
  ConPercentual Float?  @db.Float
  ConAprova     String? @db.VarChar(1)
}

model CA_ContagemFaltasPeriodo {
  FtpParDescricao      String? @db.VarChar(80)
  FtpParUniDescricao   String? @db.VarChar(80)
  FtpAprCodigo         Int     @id
  FtpFaltaDias         Int?
  FtpFaltaHoras        Int?
  FtpAulasTotais       Int?
  FtpParUniCNPJ        String? @db.VarChar(14)
  FtpAprNumSistExterno String? @db.VarChar(15)
  FtpAprNome           String? @db.VarChar(60)
  FtpParceiro          Int?
}

model CA_Cursos {
  CurCodigo         String @id @db.VarChar(6)
  CurDescricao      String @db.VarChar(80)
  CurCargaHoraria   Int?
  CurAbreviatura    String @db.VarChar(12)
  EnsNumeroPeriodos Int?   @db.SmallInt
}

model CA_CursosSuperior {
  CsupCodigo    Int     @id @default(autoincrement())
  CsupDescricao String? @db.VarChar(80)
}

model CA_DatasEncontros {
  DteData          DateTime @id @db.DateTime
  DteTipoEncontro  String   @db.VarChar(1)
  DteLocalEncontro String?  @db.VarChar(255)
}

model CA_Disciplinas {
  DisCodigo      Int     @id @default(autoincrement()) @db.SmallInt
  DisDescricao   String? @db.VarChar(80)
  DisAbreviatura String? @db.VarChar(10)
  DisCor         String? @db.VarChar(7)
}

model CA_DisciplinasAprendiz {
  DiaCodAprendiz    Int
  DiaDisciplinaProf Int
  DiaCargaHoraria   Int?    @db.SmallInt
  DiaNumeroFaltas   Int?    @db.SmallInt
  DiaConceito       String? @db.VarChar(2)
  DiaObservacoes    String? @db.VarChar(255)
  DiaAula1          String? @db.VarChar(1)
  DiaAula2          String? @db.VarChar(1)
  DiaAula3          String? @db.VarChar(1)
  DiaAula4          String? @db.VarChar(1)
  DiaAula5          String? @db.VarChar(1)
  DiaAula6          String? @db.VarChar(1)
  DiaAula7          String? @db.VarChar(1)
  DiaAula8          String? @db.VarChar(1)
  DiaAula9          String? @db.VarChar(1)
  DiaAula10         String? @db.VarChar(1)
  DiaAula11         String? @db.VarChar(1)
  DiaAula12         String? @db.VarChar(1)
  DiaAula13         String? @db.VarChar(1)
  DiaAula14         String? @db.VarChar(1)
  DiaAula15         String? @db.VarChar(1)
  DieCompreensao    Int?    @db.TinyInt
  DieComLing        Int?    @db.TinyInt
  DiePostura        Int?    @db.TinyInt
  DieParticipacao   Int?    @db.TinyInt
  DiaAula16         String? @db.VarChar(1)
  DiaAula17         String? @db.VarChar(1)
  DiaAula18         String? @db.VarChar(1)
  DiaAula19         String? @db.VarChar(1)
  DiaAula20         String? @db.VarChar(1)
  DiaDestaque       String? @db.VarChar(1)
  DiaParecerFinal   String? @db.VarChar(255)

  @@id([DiaCodAprendiz, DiaDisciplinaProf])
}

model CA_DisciplinasTurmaProf {
  DPTurma       Int
  DPProf        Int
  DPDisciplina  Int       @db.SmallInt
  DPDataInicio  DateTime  @db.DateTime
  DPDataTermino DateTime? @db.DateTime
  DpSalaFisica  String?   @db.VarChar(30)
  DpOrdem Int @id @default(autoincrement())
  DPProfAux     Int?
  DPParecer01   String?   @db.Text
  DPParecer02   String?   @db.Text
  DPParecer03   String?   @db.Text

  @@unique([DPTurma, DPProf, DPDisciplina, DPDataInicio])
}

model CA_Documentos {
  DocCodigo        String  @id @db.VarChar(3)
  DocDescricao     String? @db.VarChar(120)
  DocValor         Float?  @db.Float
  DocTipo          String? @db.VarChar(1)
  DocObrigatorio   String? @db.VarChar(1)
  DocDiasEntrega   Int?    @db.SmallInt
  DocProtocolo     String? @db.VarChar(1)
  DocOrientacoes   String? @db.VarChar(4000)
  DocExigeAnexo    String? @db.VarChar(1)
  DocOrientacoes02 String? @db.VarChar(4000)
}

model CA_DocumentosAprendiz {
  DAprMatricula     Int
  DAprDocumento     String    @db.VarChar(3)
  DAprDataSolic     DateTime  @db.DateTime
  DAprDataEntrega   DateTime? @db.DateTime
  DAprUsuario       String?   @db.VarChar(8)
  DAprObservacao    String?   @db.VarChar(4000)
  DAprStatus        String?   @db.VarChar(1)
  DAprSequencia Int @id @default(autoincrement())
  DAprDocAnexo      String?   @db.VarChar(1)
  DAprJustificativa String?   @db.VarChar(4000)
  DAprParecer       String?   @db.VarChar(4000)
  DAprStatusParecer String?   @db.VarChar(1)
  DAprUsuParecer    String?   @db.VarChar(8)
  DAprDataParecer   DateTime? @db.DateTime
  DAprContParacer   String?   @db.VarChar(4000)
  AluNomeAnexo      String?   @db.VarChar(255)
  DAprPrevEntrega   DateTime? @db.DateTime

  @@unique([DAprMatricula, DAprDocumento, DAprDataSolic])
}

model CA_Educadores {
  EducCodigo                Int       @id @default(autoincrement())
  EducNome                  String?   @db.VarChar(50)
  EducSexo                  String?   @db.VarChar(1)
  EducEndereco              String?   @db.VarChar(50)
  EducNumeroEndereco        String?   @db.VarChar(6)
  EducComplemento           String?   @db.VarChar(20)
  EducBairro                String?   @db.VarChar(50)
  EducCidade                String?   @db.VarChar(30)
  EducUF                    String?   @db.VarChar(2)
  EducCEP                   String?   @db.VarChar(9)
  EducTelefone              String?   @db.VarChar(10)
  EducTelefoneCelular       String?   @db.VarChar(11)
  EducEMail                 String?   @db.VarChar(60)
  EducDataNascimento        DateTime? @db.DateTime
  EducNaturalidade          String?   @db.VarChar(30)
  EducUFNaturalidade        String?   @db.VarChar(2)
  EducEstadoCivil           String?   @db.VarChar(1)
  EducNomedoPai             String?   @db.VarChar(50)
  EducNomedaMae             String?   @db.VarChar(50)
  EducSituacao              String?   @db.VarChar(1)
  EducDataEntrada           DateTime? @db.DateTime
  EducDataSaida             DateTime? @db.DateTime
  EducTipoAdmissao          String?   @db.VarChar(25)
  EducIdentidade            String?   @db.VarChar(15)
  EducExpedIdentidade       String?   @db.VarChar(8)
  EducCPF                   String?   @db.VarChar(11)
  EducTitulodeEleitor       String?   @db.VarChar(15)
  EducZonaEleitoral         String?   @db.VarChar(4)
  EducSecaoEleitoral        String?   @db.VarChar(4)
  EducMunEleitoral          String?   @db.VarChar(30)
  EducSenha                 String?   @db.VarChar(8)
  EducCartprofissional      String?   @db.VarChar(20)
  EducSerieCartProfissional String?   @db.VarChar(5)
  EducObservacoes           String?   @db.VarChar(255)
  EducGrauInstrucao         Int?
  EducNumSistInterno        String?   @db.VarChar(15)
  EducTipo                  String?   @db.VarChar(1)

  @@map("CA_Educadores")
}

model CA_Encaminhamentos {
  Enc_CodigoAprendiz Int
  Enc_DataEncaminha  DateTime @db.DateTime
  Enc_Horario        String?  @db.VarChar(4)
  Enc_UnidParceiro   Int
  Enc_Contato        String?  @db.VarChar(50)
  Enc_Status         String   @db.VarChar(2)
  Enc_Observacoes    String?  @db.VarChar(255)
  Enc_Usuario        String   @db.VarChar(8)
  Enc_Trajeto        String?  @db.VarChar(500)
  Enc_Sequencia      Int      @id @default(autoincrement())
  Enc_Requisicao     Int?
  Enc_Feedback       String?  @db.VarChar(500)

  @@unique([Enc_CodigoAprendiz, Enc_DataEncaminha])
}

model CA_Escolas {
  EscCodigo         Int     @id @default(autoincrement())
  EscNome           String? @db.VarChar(50)
  EscEndereco       String? @db.VarChar(80)
  EscNumeroEndereco String? @db.VarChar(6)
  EscComplemento    String? @db.VarChar(30)
  EscBairro         String? @db.VarChar(50)
  EscCEP            String? @db.VarChar(8)
  EscCidade         String? @db.VarChar(50)
  EscEstado         String? @db.VarChar(2)
  EscTelefone       String? @db.VarChar(10)
  EscDiretor        String? @db.VarChar(50)
  EscEmail          String? @db.VarChar(80)
}

model CA_Eventos {
  EvnCodigo    Int      @id @default(autoincrement())
  EvnNome      String   @db.VarChar(80)
  EvnData      DateTime @db.DateTime
  EvnDescricao String?  @db.VarChar(255)
}

model CA_Fechamento {
  FechAprendiz      Int
  FechUnidade       Int
  FechMesFechamento Int
  FechAnoFechamento String @db.VarChar(4)
  FechBolsa         Float  @db.Float
  FechTaxa          Float  @db.Float
  FechPagamento     String @db.VarChar(1)
  FechTurma         Int?
  FechAreaAtuacao   Int?

  @@id([FechAprendiz, FechUnidade, FechMesFechamento, FechAnoFechamento])
}

model CA_Feriados {
  FerUnidade   Int
  FerData      DateTime @db.DateTime
  FerDescricao String?  @db.VarChar(50)
  FerOrdem Int @id @default(autoincrement())
  FerTipo      String?  @db.VarChar(1)

  @@unique([FerUnidade, FerData])
}

model CA_Frequecia {
  FreqAprendiz        Int
  FreqReferencia      String    @db.VarChar(7)
  FreqDataPrevEntrega DateTime  @db.DateTime
  FreqDataEntrega     DateTime? @db.DateTime
  FreqUsuarioEntrega  String?   @db.VarChar(8)
  FreqFaltas          String?   @db.VarChar(255)
  FreqObservacao      String?   @db.VarChar(255)
  FreqSituacao        String?   @db.VarChar(1)
  FreqOrdem Int @id @default(autoincrement())
  FreqNumFaltas       Int?

  @@unique([FreqAprendiz, FreqReferencia])
}

model CA_funcoesSistema {
  FunSCodigo    Int    @id @db.SmallInt
  FunSDescricao String @db.VarChar(200)
  FunSNomeForm  String @db.VarChar(50)
}

model CA_GrauEscolaridade {
  GreCodigo    Int     @id @default(autoincrement())
  GreDescricao String? @db.VarChar(30)
}

model CA_GrauParentesco {
  GpaCodigo    Int     @id @default(autoincrement())
  GpaDescricao String? @db.VarChar(30)
}

model CA_IndicesSociais {
