{
  "name": "pro-sis-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run api:dev\"",
    "build": "next build",
    "build:web": "next build",
    "start": "npm run start:all",
    "start:web": "next start",
    "start:all": "node scripts/start-production.mjs",
    "lint": "eslint",
    "api:install": "npm --prefix apps/api install",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:start": "npm --prefix apps/api run start",
    "build:all": "npm run build:web && npm run api:build",
    "railway:build": "npm ci --include=dev && npm --prefix apps/api ci --include=dev && npm run build:all"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-pdf/renderer": "^4.5.1",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.20",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.1.8",
    "react-dom": "^19.1.8",
    "react-hook-form": "^7.63.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.13"
  }
}
